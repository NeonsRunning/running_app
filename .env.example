# Supabase project credentials.
#
# Copy this file to .env.local and fill in the values from the Supabase
# dashboard under Project Settings > API. Both are safe in the client bundle:
# the anon key only grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used to build the links in confirmation and password-reset
# emails. Leave blank in local development — the request headers are used
# instead. Set it in production and on preview deployments, where a forwarded
# Host cannot be trusted to describe the URL the runner actually visited.
NEXT_PUBLIC_SITE_URL=
