# Supabase project credentials.
#
# Copy this file to .env.local and fill in the values from the Supabase
# dashboard under Project Settings > API. Both are safe in the client bundle:
# the anon key only grants what row-level security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used to build the links in confirmation and password-reset
# emails. Leave blank in local development — the request headers are used
# instead. Set it in production and on preview deployments, where a forwarded
# Host cannot be trusted to describe the URL the runner actually visited.
NEXT_PUBLIC_SITE_URL=

# Supabase service role key (Project Settings > API). Server-only: never give
# it a NEXT_PUBLIC_ prefix. Payments use it to confirm a paid registration,
# including from the Stripe webhook, which has no runner session.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard > Developers > API keys). Use the test pair
# (pk_test_… / sk_test_…) locally and on previews; put the live pair only in
# the production host's secret settings, never in a file. The secret key is
# server-only; the publishable key is safe in the client bundle.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Signing secret of the webhook endpoint pointed at /api/stripe/webhook
# (event: payment_intent.succeeded). Locally, `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` prints one (whsec_…).
STRIPE_WEBHOOK_SECRET=

# Brevo transactional email (Settings > SMTP & API > API keys): sends the
# registration, payment, result and event emails. Server-only. The sender address
# must be verified in Brevo (Senders, Domains & Dedicated IPs). Leave the key
# blank to send nothing — registrations still work.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Optional; defaults to "NEONS RUNNING".
BREVO_SENDER_NAME=
# Inbox the contact form delivers to. Optional; defaults to BREVO_SENDER_EMAIL.
CONTACT_EMAIL=

# Shared secret for /api/cron/race-reminders, which sends tomorrow's race
# reminders. The scheduler calling it once a day sends it as
# `Authorization: Bearer <secret>` (Vercel Cron does this by itself). Any long
# random string; left blank, the route refuses every call.
CRON_SECRET=

# ATH Móvil needs no variables: platform admins list the business accounts
# and their QR codes at /admin/payments/accounts, and each event picks one.
